{
  "id": null,
  "uid": "flashgate-overview",
  "title": "FlashGate - HTTP RED & DB Pool",
  "tags": ["flashgate", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request Rate (RPS) per Route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(flashgate_http_requests_total[15s]))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP Latency p95 & p99 (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(flashgate_http_request_duration_seconds_bucket[30s]))) * 1000",
          "legendFormat": "p95 {{route}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(flashgate_http_request_duration_seconds_bucket[30s]))) * 1000",
          "legendFormat": "p99 {{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx Error Rate (%)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(flashgate_http_requests_total{status_code=~\"5..\"}[30s])) / clamp_min(sum(rate(flashgate_http_requests_total[30s])), 1)",
          "legendFormat": "5xx %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Inflight HTTP Requests",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "flashgate_http_inflight_requests",
          "legendFormat": "inflight"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "DB Connection Pool Saturation",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "flashgate_db_pool_acquired_conns",
          "legendFormat": "acquired"
        },
        {
          "refId": "B",
          "expr": "flashgate_db_pool_idle_conns",
          "legendFormat": "idle"
        },
        {
          "refId": "C",
          "expr": "rate(flashgate_db_pool_wait_count_total[30s])",
          "legendFormat": "wait_rate/s"
        }
      ]
    }
  ]
}
