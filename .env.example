# === Application ===
APP_ENV=local
APP_PORT=8080
LOG_LEVEL=info

# Mode penyimpanan: "postgres" (Fase 3 Baseline) atau "redis" (Fase 4 Optimasi)
STORAGE_MODE=postgres

# Durasi kunci reservasi sebelum expired (detik) dan interval sweeper (detik)
RESERVATION_TTL_SECONDS=300
SWEEPER_INTERVAL_SECONDS=10

# === PostgreSQL 16 ===
DB_HOST=postgres
DB_PORT=5432
DB_HOST_PORT=5433
DB_USER=flashgate
DB_PASSWORD=changeme_local_only
DB_NAME=flashgate
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# === Redis 7 (Aktif mulai Fase 4) ===
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# === Observability (Lokal) ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
